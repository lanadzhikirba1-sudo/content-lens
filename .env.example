# --- обязательно ---
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxx      # console.apify.com → Settings → API & Integrations

# --- вход по email-коду (без SMTP код показывается прямо на экране — только для теста!) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=app-password
SMTP_FROM="content lens <you@gmail.com>"
ALLOWED_EMAILS=lana@example.com,client@example.com   # кто может входить (пусто = все)

# --- необязательно ---
SESSION_SECRET=длинная-случайная-строка
DATA_DIR=./data                 # где хранится db.json (на Railway — путь к volume)
FIRST_SYNC_MONTHS=6             # глубина первого сбора
POSTS_LIMIT=150                 # максимум постов за первый сбор
REFRESH_DAYS=30                 # какие посты перечитывать при обновлении
AUTO_SYNC_HOURS=24              # автообновление (0 = выкл)
MANUAL_SYNC_COOLDOWN_MIN=15
APIFY_PROFILE_ACTOR=apify~instagram-profile-scraper
APIFY_POSTS_ACTOR=apify~instagram-scraper
# APIFY_MOCK=1                  # тестовые данные без Apify

# --- полная статистика клиентов (Instagram API с входом через Instagram) ---
# IG_APP_ID=
# IG_APP_SECRET=
# PUBLIC_URL=https://content-lens-production-c6d7.up.railway.app
# STORY_SYNC_MIN=60

